{
  "@context": {
    "xbpei": "https://w3id.org/xb-pei/ontology#",
    "okf": "https://w3id.org/xb-pei/okf#",
    "dcterms": "http://purl.org/dc/terms/",
    "type": "okf:type",
    "title": "dcterms:title",
    "description": "dcterms:description",
    "status": "okf:status",
    "runtime": "okf:runtime",
    "performed_by": "okf:performedBy",
    "reads": { "@id": "okf:reads", "@type": "@id" },
    "writes": { "@id": "okf:writes", "@type": "@id" },
    "supports": "okf:supports",
    "steps": { "@id": "okf:step", "@container": "@set" },
    "uses": { "@id": "okf:uses", "@type": "@id" }
  }
}
