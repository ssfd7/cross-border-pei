<?xml version='1.0' encoding='utf-8'?>
<mxfile host="65bd71144e">
  <diagram id="okf" name="OKF extension overview">
    <mxGraphModel dx="1500" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1380" background="#FFFFFF" math="0" shadow="0" lineJumpsEnabled="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="One ontology at the core, a Semantic Layer (OKF bundle) around it" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#222222;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="25" y="14" width="1350" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Bundle concepts are Markdown files and their sections vary by type: computations have reads and a query, tools have writes, the procedure has steps and uses, and all of them have supports." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#444444;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="25" y="48" width="1350" height="26" as="geometry" />
        </mxCell>
        <mxCell id="ring" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFF2CC;strokeColor=#666666;strokeWidth=1.5;fontSize=14;fontColor=#222222;verticalAlign=middle;spacing=24;" parent="1" vertex="1">
          <mxGeometry x="410" y="390" width="680" height="680" as="geometry" />
        </mxCell>
        <mxCell id="core" value="&lt;b style=&quot;font-size:17px&quot;&gt;Cross Border Private Equity Ontology&lt;/b&gt;&lt;br&gt;Turtle, version 0.9&lt;br&gt;&lt;br&gt;concept meaning definitions, relationships, allowed values, stewards, review status, generated SHACL shapes" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#E2F0D9;strokeColor=#666666;strokeWidth=1.5;fontSize=13;fontColor=#222222;verticalAlign=middle;spacing=24;" parent="1" vertex="1">
          <mxGeometry x="604" y="584" width="292" height="292" as="geometry" />
        </mxCell>
        <mxCell id="p_supports" value="&lt;b style=&quot;font-size:15px&quot;&gt;supports&lt;/b&gt;&lt;br&gt;the questions and controls it serves" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=4;fillColor=#FFFFFF;strokeColor=#C55A11;strokeWidth=3;fontSize=12;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="664" y="450" width="172" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p_steps" value="&lt;b style=&quot;font-size:15px&quot;&gt;steps, uses&lt;/b&gt;&lt;br&gt;who performs each step, and with which queries and tools" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=4;fillColor=#FFFFFF;strokeColor=#C55A11;strokeWidth=3;fontSize=12;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="906" y="695" width="172" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p_sql" value="&lt;b style=&quot;font-size:15px&quot;&gt;Computation: SQL&lt;/b&gt;&lt;br&gt;one block, run exactly as written" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=4;fillColor=#FFFFFF;strokeColor=#888888;strokeWidth=1;fontSize=12;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="664" y="947" width="172" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p_cypher" value="&lt;b style=&quot;font-size:15px&quot;&gt;Computation: Cypher&lt;/b&gt;&lt;br&gt;one block, run exactly as written" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=4;fillColor=#FFFFFF;strokeColor=#888888;strokeWidth=1;fontSize=12;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="422" y="695" width="172" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p_reads" value="&lt;b style=&quot;font-size:15px&quot;&gt;reads&lt;/b&gt;&lt;br&gt;the ontology terms a query touches" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=4;fillColor=#FFFFFF;strokeColor=#C55A11;strokeWidth=3;fontSize=12;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="486" y="523" width="172" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p_writes" value="&lt;b style=&quot;font-size:15px&quot;&gt;writes&lt;/b&gt;&lt;br&gt;the ontology terms a tool creates" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=4;fillColor=#FFFFFF;strokeColor=#C55A11;strokeWidth=3;fontSize=12;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="842" y="523" width="172" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p_gloss" value="&lt;b style=&quot;font-size:15px&quot;&gt;Glossary&lt;/b&gt;&lt;br&gt;meaning and data location of each term, generated" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=4;fillColor=#FFFFFF;strokeColor=#C55A11;strokeWidth=3;fontSize=12;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="842" y="867" width="172" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p_attest" value="&lt;b style=&quot;font-size:15px&quot;&gt;parameters, attester&lt;/b&gt;&lt;br&gt;the agent supplies values only; each run is verified" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=4;fillColor=#FFFFFF;strokeColor=#888888;strokeWidth=1;fontSize=12;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="486" y="867" width="172" height="70" as="geometry" />
        </mxCell>
        <mxCell id="mcp" value="&lt;b style=&quot;font-size:15px&quot;&gt;MCP tools&lt;/b&gt;&lt;div style=&quot;margin-top:4px&quot;&gt;&lt;i&gt;bundle:&lt;/i&gt; read_concept, run_computation, mappings_for&lt;br&gt;&lt;i&gt;ontology:&lt;/i&gt; find_term, describe_term&lt;br&gt;&lt;i&gt;writes:&lt;/i&gt; open_case, record_assessment, draft_schedule&lt;br&gt;&lt;i&gt;documents:&lt;/i&gt; read_document&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#DEEAF6;strokeColor=#666666;strokeWidth=1;fontSize=12;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="1030" y="290" width="275" height="140" as="geometry" />
        </mxCell>
        <mxCell id="lt_agent" value="&lt;b style=&quot;font-size:15px&quot;&gt;LookThrough agent&lt;/b&gt;&lt;br&gt;answers the questions (planned)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=6;fillColor=#FCE4D6;strokeColor=#666666;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=12;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="1010" y="140" width="160" height="85" as="geometry" />
        </mxCell>
        <mxCell id="agent" value="&lt;b style=&quot;font-size:15px&quot;&gt;Clearance agent&lt;/b&gt;&lt;br&gt;follows the WF3 procedure" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=6;fillColor=#FCE4D6;strokeColor=#666666;strokeWidth=1;fontSize=12;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="1350" y="315" width="132" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cq" value="&lt;b style=&quot;font-size:16px&quot;&gt;Competency questions&lt;/b&gt;&lt;div style=&quot;margin-top:6px&quot;&gt;CQ1 indirect exposure to a company &amp;nbsp;·&amp;nbsp; CQ2 jurisdictions in an ownership chain &amp;nbsp;·&amp;nbsp; CQ3 cross-border payments &amp;nbsp;·&amp;nbsp; CQ4 facts and rules behind an obligation &amp;nbsp;·&amp;nbsp; CQ5 missing facts &amp;nbsp;·&amp;nbsp; &lt;font color='#888888'&gt;CQ6 what a change affects (no computation yet)&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#DEEAF6;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="540" y="120" width="420" height="125" as="geometry" />
        </mxCell>
        <mxCell id="wf" value="&lt;b style=&quot;font-size:16px&quot;&gt;Clearance workflow procedures&lt;/b&gt;&lt;div style=&quot;margin-top:6px&quot;&gt;WF3 Withholding at distribution: 12 steps, the agent for 1 to 9 and a person for 10 to 12, with controls C3.1 to C3.6.&lt;br&gt;WF1 and WF2 are written for people and not yet in the bundle.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#DEEAF6;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="1220" y="640" width="260" height="180" as="geometry" />
        </mxCell>
        <mxCell id="pg" value="&lt;b style=&quot;font-size:16px&quot;&gt;Relational DBMS: Postgres &amp;nbsp;·&amp;nbsp; SQL&lt;/b&gt;&lt;div style=&quot;margin-top:6px&quot;&gt;9 SQL computations on six source-system schemas: entity management, investor register, onboarding, treasury, documents and the rule library.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#E8E6F2;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="530" y="1180" width="440" height="105" as="geometry" />
        </mxCell>
        <mxCell id="lb" value="&lt;b style=&quot;font-size:16px&quot;&gt;LPG Knowledge Graph: LadybugDB &amp;nbsp;·&amp;nbsp; Cypher&lt;/b&gt;&lt;div style=&quot;margin-top:6px&quot;&gt;3 Cypher computations for path questions through ownership chains.&lt;br&gt;The graph is rebuilt from Postgres and uses the ontology's property names.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#E8E6F2;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="20" y="635" width="200" height="190" as="geometry" />
        </mxCell>
        <mxCell id="e_cq" value="names the questions&lt;br&gt;it helps answer" style="endArrow=block;endFill=1;endSize=8;html=1;rounded=0;strokeColor=#444444;strokeWidth=1.6;fontSize=12;fontColor=#222222;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;" parent="1" source="p_supports" target="cq" edge="1">
          <mxGeometry x="0.45" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_agent" value="calls" style="endArrow=block;endFill=1;endSize=8;html=1;rounded=0;strokeColor=#444444;strokeWidth=1.6;fontSize=12;fontColor=#222222;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;" parent="1" source="agent" target="mcp" edge="1">
          <mxGeometry x="0.00" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_agent_wf" value="carries out" style="endArrow=block;endFill=1;endSize=8;html=1;rounded=0;strokeColor=#444444;strokeWidth=1.6;fontSize=12;fontColor=#222222;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.7538;entryY=0.0000;entryDx=0;entryDy=0;" parent="1" source="agent" target="wf" edge="1">
          <mxGeometry x="0.00" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_lt_mcp" value="calls" style="endArrow=block;endFill=1;endSize=8;html=1;rounded=0;strokeColor=#444444;strokeWidth=1.6;fontSize=12;fontColor=#222222;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.2182;entryY=0.0000;entryDx=0;entryDy=0;" parent="1" source="lt_agent" target="mcp" edge="1">
          <mxGeometry x="0.00" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_lt_cq" value="takes" style="endArrow=block;endFill=1;endSize=8;html=1;rounded=0;strokeColor=#444444;strokeWidth=1.6;fontSize=12;fontColor=#222222;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.0000;exitY=0.4941;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.4960;entryDx=0;entryDy=0;" parent="1" source="lt_agent" target="cq" edge="1">
          <mxGeometry x="0.00" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_mcp" value="read and run" style="endArrow=block;endFill=1;endSize=8;html=1;rounded=0;strokeColor=#444444;strokeWidth=1.6;fontSize=12;fontColor=#222222;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.0909;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.8535;entryY=0.1465;entryDx=0;entryDy=0;" parent="1" source="mcp" target="ring" edge="1">
          <mxGeometry x="0.00" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_wf" value="restate&lt;br&gt;as steps" style="endArrow=block;endFill=1;endSize=8;html=1;rounded=0;strokeColor=#444444;strokeWidth=1.6;fontSize=12;fontColor=#222222;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" parent="1" source="p_steps" target="wf" edge="1">
          <mxGeometry x="0.45" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_pg" value="runs on" style="endArrow=block;endFill=1;endSize=8;html=1;rounded=0;strokeColor=#444444;strokeWidth=1.6;fontSize=12;fontColor=#222222;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" parent="1" source="p_sql" target="pg" edge="1">
          <mxGeometry x="-0.66" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_lb" value="runs on" style="endArrow=block;endFill=1;endSize=8;html=1;rounded=0;strokeColor=#444444;strokeWidth=1.6;fontSize=12;fontColor=#222222;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;" parent="1" source="p_cypher" target="lb" edge="1">
          <mxGeometry x="-0.63" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m_sql" value="&lt;b style=&quot;font-size:14px&quot;&gt;Mappings&lt;/b&gt;&lt;br&gt;7 YAML files: ontology term → table, column" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=3;fillColor=#FFFFFF;strokeColor=#C55A11;strokeWidth=3;fontSize=12;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="622" y="1094" width="256" height="50" as="geometry" />
        </mxCell>
        <mxCell id="m_graph" value="&lt;b style=&quot;font-size:14px&quot;&gt;Mapping&lt;/b&gt;&lt;br&gt;1 YAML file: term → node, edge" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=3;fillColor=#FFFFFF;strokeColor=#C55A11;strokeWidth=3;fontSize=12;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="238" y="696" width="122" height="68" as="geometry" />
        </mxCell>
        <mxCell id="ring_title" value="&lt;b&gt;Semantic Layer: OKF bundle concepts&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#222222;strokeColor=none;fillColor=#FFF2CC;" parent="1" vertex="1">
          <mxGeometry x="625" y="416" width="250" height="26" as="geometry" />
        </mxCell>
        <mxCell id="n_tl" value="&lt;b style=&quot;font-size:15px;color:#C55A11&quot;&gt;One meaning everywhere&lt;/b&gt;&lt;br&gt;Each computation and tool carries the ontology's own definition of the terms it uses and where they live in the data. The glossary is generated, never retyped, and stamped with the ontology version." style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fillColor=none;strokeColor=none;fontSize=13;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="25" y="125" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n_tr" value="&lt;b style=&quot;font-size:15px;color:#C55A11&quot;&gt;Traceable&lt;/b&gt;&lt;br&gt;Each query and tool names the question, the workflow step and the control it serves, and the terms it depends on." style="text;whiteSpace=wrap;html=1;align=right;verticalAlign=top;spacing=4;fillColor=none;strokeColor=none;fontSize=13;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="1200" y="125" width="275" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n_bl" value="&lt;b style=&quot;font-size:15px;color:#C55A11&quot;&gt;Same terms, two engines&lt;/b&gt;&lt;br&gt;SQL and Cypher computations name the same ontology terms, so an answer from the graph and one from the tables mean the same thing." style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fillColor=none;strokeColor=none;fontSize=13;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="25" y="1185" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n_br" value="&lt;b style=&quot;font-size:15px;color:#C55A11&quot;&gt;Change is visible&lt;/b&gt;&lt;br&gt;When a term changes, reads and writes show which queries, tools and steps are affected, and a glossary that no longer matches the ontology or the mappings fails the check." style="text;whiteSpace=wrap;html=1;align=right;verticalAlign=top;spacing=4;fillColor=none;strokeColor=none;fontSize=13;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="1075" y="1185" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;span style=&quot;border:3px solid #C55A11;border-radius:6px&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; &amp;nbsp;the proposed extension to OKF: reads, writes, supports, steps and uses, the generated Glossary section and the mappings. &amp;nbsp;&amp;nbsp; Each arrow reads source, label, target. &amp;nbsp;&amp;nbsp; Dashed outline: planned, not built." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#444444;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="25" y="1320" width="1450" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>