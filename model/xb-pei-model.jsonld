      "rdfs:range": {
        "@id": "xsd:decimal"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Total capital committed to the fund vehicle, in the fund currency."
      },
      "xbpei:steward": "Fund administration",
      "xbpei:termStatus": "reviewed"
    },
    {
      "@id": "xbpei:OperatingLocation",
      "@type": [
        "xbpei:JurisdictionFactType",
        "owl:NamedIndividual"
      ],
      "skos:inScheme": {
        "@id": "xbpei:JurisdictionFactTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Operating location"
      },
      "xbpei:steward": "Knowledge engineering",
      "xbpei:termStatus": "reviewed"
    },
    {
      "@id": "xbpei:BeneficialOwner",
      "@type": "owl:Class",
      "owl:equivalentClass": {
        "@id": "_:n6d9ef97dcff747149f71a20dcacebfb4b13"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Beneficial Owner"
      },
      "rdfs:subClassOf": {
        "@id": "xbpei:Party"
      },
      "skos:changeNote": {
        "@language": "en",
        "@value": "Added in v0.9."
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A party that holds at least one ownership interest for its own benefit, so that the income from it is its own. Membership follows from the interests held and is not asserted."
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "The tax sense: the party entitled to the income. Not the natural person who ultimately controls an entity, as the term is used in know-your-customer work."
      },
      "xbpei:steward": "Fund administration",
      "xbpei:termStatus": "proposed"
    },
    {
      "@id": "_:n6d9ef97dcff747149f71a20dcacebfb4b13",
      "@type": "owl:Class",
      "owl:intersectionOf": {
