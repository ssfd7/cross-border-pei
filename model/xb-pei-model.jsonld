        "@language": "en",
        "@value": "Added in v0.9."
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The team accountable for the meaning of a term and for approving changes to it."
      },
      "xbpei:steward": "Knowledge engineering",
      "xbpei:termStatus": "proposed"
    },
    {
      "@id": "xbpei:Jurisdiction",
      "@type": "owl:Class",
      "rdfs:label": {
        "@language": "en",
        "@value": "Jurisdiction"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A territory with its own legal or tax authority, national or sub-national."
      },
      "xbpei:steward": "Fund tax team",
      "xbpei:termStatus": "reviewed"
    },
    {
      "@id": "https://w3id.org/xb-pei/ontology",
      "@type": [
        "owl:Ontology",
        "dcat:Dataset"
      ],
      "dcat:distribution": {
        "@id": "_:n6d9ef97dcff747149f71a20dcacebfb4b1"
      },
      "dcat:keyword": [
        {
          "@language": "en",
          "@value": "private equity"
        },
        {
          "@language": "en",
          "@value": "cross-border"
        },
        {
          "@language": "en",
          "@value": "tax obligation"
        },
        {
          "@language": "en",
          "@value": "ownership"
        }
      ],
      "dcterms:created": {
        "@type": "xsd:date",
        "@value": "2026-10-05"
      },
      "dcterms:description": {
        "@language": "en",
        "@value": "Structural semantic model of a private equity fund investing through legal entities across jurisdictions, and of the facts, rules and evidence behind tax-obligation assessments. Formal counterpart of xb-pei-model.drawio. Not a tax engine; no jurisdiction-specific rule is encoded."
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-10-06"
      },
      "dcterms:title": {
        "@language": "en",
        "@value": "Cross-border private equity investment ontology"
      },
      "owl:versionIRI": {
        "@id": "https://w3id.org/xb-pei/ontology/0.9"
      },
      "owl:versionInfo": "0.9",
      "vann:preferredNamespacePrefix": "xbpei",
      "vann:preferredNamespaceUri": "https://w3id.org/xb-pei/ontology#"
    },
    {
      "@id": "_:n6d9ef97dcff747149f71a20dcacebfb4b1",
      "@type": "dcat:Distribution",
      "dcat:mediaType": {
        "@id": "https://www.iana.org/assignments/media-types/text/turtle"
      },
      "dcterms:format": "text/turtle",
      "dcterms:title": {
        "@language": "en",
        "@value": "Turtle serialization"
      }
    },
    {
      "@id": "xbpei:committedCapital",
