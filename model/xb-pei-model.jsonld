    {
      "@id": "xbpei:WithholdingDetermination",
      "@type": "owl:Class",
      "rdfs:label": {
        "@language": "en",
        "@value": "Withholding Determination"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The treatment decided for one party and one distribution component: the outcome, the rate and its basis, the clearance relied on and the assessment that supports it."
      },
      "xbpei:steward": "Fund tax team",
      "xbpei:termStatus": "proposed"
    },
    {
      "@id": "xbpei:steward",
      "@type": "owl:AnnotationProperty",
