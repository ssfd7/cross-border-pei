        "@language": "en",
        "@value": "Distribution Component"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The part of a distribution that has one income type and one source jurisdiction."
      },
      "xbpei:steward": "Fund tax team",
      "xbpei:termStatus": "proposed"
    },
    {
      "@id": "xbpei:FactRequirement",
      "@type": "owl:Class",
      "rdfs:label": {
        "@language": "en",
        "@value": "Fact Requirement"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A fact that a rule version needs before its applicability can be determined."
      },
      "xbpei:steward": "Fund tax team",
      "xbpei:termStatus": "proposed"
    },
    {
      "@id": "xbpei:WithholdingSchedule",
      "@type": "owl:Class",
      "rdfs:label": {
        "@language": "en",
        "@value": "Withholding Schedule"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The set of withholding determinations for a distribution, prepared, reviewed and signed off before payments are released. A corrected schedule is a new record."
      },
      "xbpei:steward": "Fund tax team",
      "xbpei:termStatus": "proposed"
    },
    {
      "@id": "xbpei:partOfDistribution",
      "@type": [
        "owl:ObjectProperty",
        "owl:FunctionalProperty"
      ],
      "rdfs:domain": {
        "@id": "xbpei:PaymentEvent"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "partOfDistribution"
      },
      "rdfs:range": {
        "@id": "xbpei:DistributionEvent"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The distribution a payment belongs to."
      },
      "xbpei:steward": "Fund tax team",
      "xbpei:termStatus": "proposed"
    },
    {
      "@id": "xbpei:ChangeEvent",
      "@type": "owl:Class",
      "rdfs:label": {
        "@language": "en",
        "@value": "Change Event"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A recorded change to a fact that triggers review of assessments relying on it. A change triggers review; it does not itself prove that an obligation changed."
      },
      "xbpei:steward": "Fund finance and treasury",
      "xbpei:termStatus": "proposed"
    },
    {
      "@id": "xbpei:determinationOutcome",
