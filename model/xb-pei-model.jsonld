    {
      "@id": "xbpei:Clearance",
      "@type": "owl:Class",
      "rdfs:label": {
        "@language": "en",
        "@value": "Clearance"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A dated decision on whether a party's tax documentation supports its treatment as an investor in a fund vehicle, with the certifications and facts relied on and any open items. A renewed or withdrawn clearance is a new record; earlier records are kept."
      },
      "xbpei:steward": "Fund tax team",
      "xbpei:termStatus": "proposed"
    },
    {
      "@id": "xbpei:releasedAgainst",
      "@type": [
        "owl:ObjectProperty",
        "owl:FunctionalProperty"
      ],
      "rdfs:domain": {
