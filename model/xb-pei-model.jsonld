      "xbpei:steward": "Knowledge engineering",
      "xbpei:termStatus": "proposed"
    },
    {
      "@id": "xbpei:decidedOn",
      "@type": [
        "owl:DatatypeProperty",
        "owl:FunctionalProperty"
      ],
      "rdfs:domain": {
        "@id": "_:n6d9ef97dcff747149f71a20dcacebfb4b83"
