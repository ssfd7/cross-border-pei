      },
      "rdfs:label": {
        "@language": "en",
        "@value": "releasedAgainst"
      },
      "rdfs:range": {
        "@id": "xbpei:WithholdingSchedule"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The signed schedule against which the payment was released."
      },
      "xbpei:steward": "Fund tax team",
      "xbpei:termStatus": "proposed"
    },
    {
      "@id": "xbpei:reliesOnClearance",
